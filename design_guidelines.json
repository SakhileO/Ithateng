        "url": "https://images.unsplash.com/photo-1645735123314-d11fcfdd0000?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Close up of long lashes"
      },
      {
        "category": "Nails",
        "url": "https://images.unsplash.com/photo-1672815554809-37e355eddd24?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Elegant nail art close up"
      },
      {
        "category": "Makeup",
        "url": "https://images.unsplash.com/photo-1747823490861-1fa6d0132fee?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Detailed eye makeup"
      },
      {
        "category": "Wigs",
        "url": "https://images.unsplash.com/photo-1695556746240-55d9f92faf43?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Woman with luxury wig"
      }
    ],
    "about": [
      {
        "url": "https://images.unsplash.com/photo-1601288717546-f26deef256d7?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Chic waiting area interior",
        "position": "About Main"
      }
    ],
    "products": [
      {
        "url": "https://images.unsplash.com/photo-1627458805084-949391e56443?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Minimalist beauty bottle on stone",
        "position": "Product Feature"
      }
    ]
  },
  "required_libraries": [
    "framer-motion",
    "clsx",
    "tailwind-merge",
    "lucide-react",
    "react-day-picker",
    "sonner",
    "@radix-ui/react-dialog",
    "@radix-ui/react-slot"
  ],
  "universal_guidelines": [
    "Use 'framer-motion' for all entrance animations (staggerChildren).",
    "Buttons must have 'pill' shape (rounded-full) for organic feel.",
    "Do not use generic shadows; use 1px borders with low opacity.",
    "Ensure 80vh max height for images on mobile.",
    "Use 'sonner' for all toast notifications.",
    "Dark mode is NOT priority; optimize for Light/Cream mode.",
    "Never use 'Inter' for headings. Use Playfair Display.",
    "Test all interactive elements with data-testid."
  ]
}