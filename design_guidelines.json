{
  "project_name": "Ithateng By Ale",
  "persona": "E1: The Anti-AI Designer",
  "theme": "light",
  "design_philosophy": {
    "core_principle": "Fusion over Imitation: High-end Fashion Magazine x Spa Serenity",
    "emotional_goal": "Confidence, Luxury, Serenity, Professionalism",
    "anti_patterns": [
      "No generic purple/teal CTAs",
      "No 'Inter' font for headings",
      "No centered-everything layouts",
      "No heavy drop shadows (use borders/opacity instead)"
    ]
  },
  "typography": {
    "headings": {
      "font_family": "Playfair Display, serif",
      "weight": "600",
      "tracking": "tracking-tight",
      "usage": "H1, H2, H3, Hero Titles"
    },
    "body": {
      "font_family": "Manrope, sans-serif",
      "weight": "400",
      "tracking": "tracking-wide",
      "usage": "Paragraphs, UI Elements, Buttons"
    },
    "accents": {
      "font_family": "Cormorant Garamond, serif",
      "style": "italic",
      "usage": "Blockquotes, Testimonials, Decorative text"
    }
  },
  "colors": {
    "palette": {
      "background": "#FDFCF8",
      "foreground": "#1C1917",
      "primary": "#1C1917",
      "primary_foreground": "#FDFCF8",
      "secondary": "#E6D2C9",
      "secondary_foreground": "#4A3B32",
      "accent": "#D4AF37",
      "accent_foreground": "#FFFFFF",
      "muted": "#F2F0E9",
      "muted_foreground": "#78716C",
      "border": "#E7E5E4",
      "input": "#E7E5E4",
      "ring": "#D4AF37"
    },
    "usage_rules": {
      "primary_cta": "bg-primary text-primary-foreground hover:bg-primary/90 pill-shaped",
      "secondary_cta": "border border-primary text-primary hover:bg-secondary/20 pill-shaped",
      "sections": {
        "hero": "bg-background",
        "features": "bg-muted/30",
        "footer": "bg-primary text-primary-foreground"
      }
    }
  },
  "layout_strategy": {
    "spacing": {
      "base": "Generous (2x standard)",
      "container_padding": "p-6 md:p-12 lg:p-20",
      "section_gap": "gap-16 md:gap-32"
    },
    "grid_system": {
      "mode": "Bento Grid (Mode A)",
      "columns": "grid-cols-1 md:grid-cols-12",
      "gap": "gap-6 md:gap-8"
    },
    "container_width": "max-w-7xl mx-auto"
  },
  "component_guidelines": {
    "buttons": {
      "style": "rounded-full px-8 py-6 text-sm font-medium tracking-widest transition-transform hover:scale-105 active:scale-95",
      "variants": ["default", "outline", "ghost"]
    },
    "cards": {
      "style": "bg-white border border-border/40 p-8 rounded-xl hover:shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500",
      "content_padding": "p-8"
    },
    "inputs": {
      "style": "bg-transparent border-b border-input px-0 py-4 rounded-none focus-visible:ring-0 focus-visible:border-primary placeholder:text-muted-foreground/50 font-serif text-lg"
    },
    "images": {
      "style": "rounded-lg grayscale-[20%] hover:grayscale-0 transition-all duration-700 ease-out object-cover",
      "aspect_ratios": {
        "hero": "aspect-[3/4] md:aspect-[4/5]",
        "gallery": "aspect-square",
        "portrait": "aspect-[2/3]"
      }
    }
  },
  "visual_enhancers": {
    "textures": "Subtle noise overlay on solid backgrounds (opacity 0.02)",
    "motion": {
      "library": "framer-motion",
      "default_transition": {
        "duration": 0.8,
        "ease": [0.22, 1, 0.36, 1]
      },
      "stagger": 0.1
    },
    "decorations": "Thin 1px lines, overlapping elements, italic serif annotations"
  },
  "image_urls": {
    "hero_section": [
      {
