        "alt": "Elegant woman near white wall, minimalist beauty",
        "position": "Hero Main"
      },
      {
        "url": "https://images.unsplash.com/photo-1765852549115-2ee9f55a1980?crop=entropy&cs=srgb&fm=jpg&q=85",
        "alt": "Woman applying makeup at vanity",
        "position": "Hero Secondary"
      }
    ],
    "services": [
      {
